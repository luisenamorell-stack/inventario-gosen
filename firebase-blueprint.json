{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An inventory item in the store catalog",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 150 },
        "size": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 200 },
        "colors": { "type": "array" },
        "supplier": { "type": "string", "maxLength": 300 },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "discountType": { "type": "string", "maxLength": 50 },
        "discountValue": { "type": "number" },
        "stock": { "type": "integer" },
        "warehouseStocks": { "type": "object" },
        "colorStocks": { "type": "object" },
        "img": { "type": "string", "maxLength": 1048576 },
        "img2": { "type": "string", "maxLength": 1048576 }
      },
      "required": ["code", "name", "category", "price", "stock"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A supplier or vendor company providing merchandise",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 300 },
        "contact": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 300 },
        "address": { "type": "string", "maxLength": 600 }
      },
      "required": ["name"]
    },
    "AuditHistory": {
      "title": "AuditHistory",
      "description": "Historical log of an inventory physical count audit",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "number" },
        "match": { "type": "integer" },
        "missing": { "type": "integer" },
        "extra": { "type": "integer" },
        "netImpact": { "type": "number" },
        "totalItems": { "type": "integer" },
        "scope": { "type": "string", "maxLength": 200 }
      },
      "required": ["date", "match", "missing", "extra"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store branding configuration, operational documents (finance, warehouses, restaurant, quotations, SaaS global config), and hashed access credentials",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "storeName": { "type": "string", "maxLength": 300 },
        "tagline": { "type": "string", "maxLength": 300 },
        "logoUrl": { "type": "string", "maxLength": 1048576 },
        "phone": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 600 },
        "storeRtn": { "type": "string", "maxLength": 100 },
        "accessPassword": { "type": "string", "maxLength": 300 },
        "whatsappOrderPhone": { "type": "string", "maxLength": 100 },
        "catalogWelcomeMsg": { "type": "string", "maxLength": 1000 },
        "allowedModules": { "type": "array" },
        "enableWarrantyModule": { "type": "boolean" },
        "warrantyTitle": { "type": "string", "maxLength": 200 },
        "quotations": { "type": "array" },
        "storeLocations": { "type": "array" },
        "bankAccounts": { "type": "array" },
        "invoiceTemplate": { "type": "object" },
        "shifts": { "type": "array" },
        "warehouses": { "type": "array" },
        "tables": { "type": "array" },
        "requests": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    },
    "Sale": {
      "title": "Sale",
      "description": "A completed retail sales transaction record with items, totals, credit contract, and warranty metadata",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "saleNumber": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "number" },
        "date": { "type": "string", "maxLength": 150 },
        "items": { "type": "array" },
        "totalItems": { "type": "integer" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 100 },
        "amountPaid": { "type": "number" },
        "change": { "type": "number" },
        "balanceDue": { "type": "number" },
        "creditStatus": { "type": "string", "maxLength": 50 },
        "creditDueDate": { "type": "string", "maxLength": 100 },
        "creditPayments": { "type": "array" },
        "creditContract": { "type": "object" },
        "customerName": { "type": "string", "maxLength": 300 },
        "customerPhone": { "type": "string", "maxLength": 100 },
        "customerRtn": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 50 },
        "cashier": { "type": "string", "maxLength": 150 },
        "cashierRole": { "type": "string", "maxLength": 50 }
      },
      "required": ["saleNumber", "timestamp", "date", "items", "total", "status"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A supplier purchase invoice reception record with merchandise items and updated stock",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "invoiceNumber": { "type": "string", "maxLength": 150 },
        "supplierId": { "type": "string", "maxLength": 200 },
        "supplierName": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "number" },
        "paymentCondition": { "type": "string", "maxLength": 100 },
        "dueDate": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "totalItems": { "type": "integer" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 50 },
        "receivedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["invoiceNumber", "supplierId", "supplierName", "date", "timestamp", "items", "total", "status"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "A store employee or collaborator account with custom module permissions and hashed password",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 300 },
        "username": { "type": "string", "maxLength": 150 },
        "password": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "allowedTabs": { "type": "array" },
        "allowedWarehouseIds": { "type": "array" },
        "salesPermissions": { "type": "object" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["name", "username", "password", "role", "isActive"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "An immutable audit trail movement entry recorded when an employee performs actions",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "number" },
        "date": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 200 },
        "userRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 1000 },
        "module": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 }
      },
      "required": ["timestamp", "date", "userName", "action", "module"]
    },
    "CompanyTenant": {
      "title": "CompanyTenant",
      "description": "A registered SaaS client business tenant with its own isolated inventory, module permissions, and hashed admin credential",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 150 },
        "ownerName": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 300 },
        "plan": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "nextBillingDate": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "adminPassword": { "type": "string", "maxLength": 300 },
        "logoUrl": { "type": "string", "maxLength": 1048576 },
        "tagline": { "type": "string", "maxLength": 300 },
        "address": { "type": "string", "maxLength": 600 },
        "notes": { "type": "string", "maxLength": 2000 },
        "allowedModules": { "type": "array" },
        "enableWarrantyModule": { "type": "boolean" },
        "enableCreditContract": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "isPrimary": { "type": "boolean" }
      },
      "required": ["name", "slug", "status", "adminPassword"]
    }
  },
  "firestore": {
    "/inventory/{productId}": {
      "schema": "Product",
      "description": "Collection of all retail inventory products and stock counts"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Collection of wholesale suppliers and vendor contact directories"
    },
    "/audit_history/{auditId}": {
      "schema": "AuditHistory",
      "description": "Collection of closed audit reconciliation sessions"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store profile configuration, operational documents, and SaaS global settings"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of completed and logged customer sales transactions"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Collection of registered supplier purchase invoices and stock receipts"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Collection of store collaborator profiles and module permission assignments"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time immutable audit trail of all staff movements and operations"
    },
    "/companies/{companyId}": {
      "schema": "CompanyTenant",
      "description": "Collection of SaaS client companies and subscription licenses"
    }
  }
}
