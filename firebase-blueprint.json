{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An inventory item in the store catalog",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "size": { "type": "string", "maxLength": 50 },
        "supplier": { "type": "string", "maxLength": 200 },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "stock": { "type": "integer" },
        "img": { "type": "string", "maxLength": 500000 }
      },
      "required": ["code", "name", "category", "price", "stock"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A supplier or vendor company providing merchandise",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "contact": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 }
      },
      "required": ["name"]
    },
    "AuditHistory": {
      "title": "AuditHistory",
      "description": "Historical log of an inventory physical count audit",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "number" },
        "match": { "type": "integer" },
        "missing": { "type": "integer" },
        "extra": { "type": "integer" },
        "netImpact": { "type": "number" },
        "totalItems": { "type": "integer" },
        "scope": { "type": "string", "maxLength": 100 }
      },
      "required": ["date", "match", "missing", "extra"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store branding configuration including store name, custom logo image, and access password",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 500000 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "accessPassword": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "number" }
      },
      "required": ["storeName"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A completed retail sales transaction record with items and totals",
      "type": "object",
      "properties": {
        "saleNumber": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "number" },
        "date": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "totalItems": { "type": "integer" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "amountPaid": { "type": "number" },
        "change": { "type": "number" },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "customerRtn": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "cashier": { "type": "string", "maxLength": 100 }
      },
      "required": ["saleNumber", "timestamp", "date", "items", "total", "status"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A supplier purchase invoice reception record with merchandise items and updated stock",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 100 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "number" },
        "paymentCondition": { "type": "string", "maxLength": 50 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "totalItems": { "type": "integer" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "receivedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["invoiceNumber", "supplierId", "supplierName", "date", "timestamp", "items", "total", "status"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "A store employee or collaborator account with custom module permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "allowedTabs": { "type": "array" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["name", "username", "password", "role", "isActive"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "An audit trail movement entry recorded when an employee performs actions",
      "type": "object",
      "properties": {
        "timestamp": { "type": "number" },
        "date": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 200 },
        "userRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 500 },
        "module": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 }
      },
      "required": ["timestamp", "date", "userName", "action", "module"]
    }
  },
  "firestore": {
    "/inventory/{productId}": {
      "schema": "Product",
      "description": "Collection of all retail inventory products and stock counts"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Collection of wholesale suppliers and vendor contact directories"
    },
    "/audit_history/{auditId}": {
      "schema": "AuditHistory",
      "description": "Collection of closed audit reconciliation sessions"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store profile configuration including custom store name and brand logo"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of completed and logged customer sales transactions"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Collection of registered supplier purchase invoices and stock receipts"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Collection of store collaborator profiles and module permission assignments"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time audit trail of all staff movements and operations"
    }
  }
}
