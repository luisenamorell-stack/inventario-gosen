rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'price', 'stock']) &&
             data.code is string && data.code.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             (!('size' in data) || (data.size is string && data.size.size() <= 50)) &&
             (!('supplier' in data) || (data.supplier is string && data.supplier.size() <= 200)) &&
             (!('cost' in data) || (data.cost is number)) &&
             data.price is number &&
             (!('discount' in data) || (data.discount is number)) &&
             (!('discountType' in data) || (data.discountType is string && data.discountType.size() <= 20)) &&
             (!('discountValue' in data) || (data.discountValue is number)) &&
             (data.stock is number || data.stock is int) &&
             (!('img' in data) || (data.img is string && data.img.size() <= 500000));
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 200 &&
             (!('contact' in data) || (data.contact is string && data.contact.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500));
    }

    function isValidAuditHistory(data) {
      return data.keys().hasAll(['date', 'match', 'missing', 'extra']) &&
             data.date is string && data.date.size() <= 100 &&
             (data.match is number || data.match is int) &&
             (data.missing is number || data.missing is int) &&
             (data.extra is number || data.extra is int) &&
             (!('netImpact' in data) || (data.netImpact is number)) &&
             (!('totalItems' in data) || (data.totalItems is number || data.totalItems is int)) &&
             (!('scope' in data) || (data.scope is string && data.scope.size() <= 100));
    }

    function isValidStoreSettings(data) {
      return (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 200)) &&
             (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
             (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500000)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('accessPassword' in data) || (data.accessPassword is string && data.accessPassword.size() <= 100)) &&
             (!('whatsappOrderPhone' in data) || (data.whatsappOrderPhone is string && data.whatsappOrderPhone.size() <= 50)) &&
             (!('catalogWelcomeMsg' in data) || (data.catalogWelcomeMsg is string && data.catalogWelcomeMsg.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is string));
    }

    function isValidSale(data) {
      return data.keys().hasAll(['saleNumber', 'timestamp', 'date', 'items', 'total', 'status']) &&
             data.saleNumber is string && data.saleNumber.size() <= 50 &&
             data.timestamp is number &&
             data.date is string && data.date.size() <= 100 &&
             data.items is list &&
             (!('totalItems' in data) || (data.totalItems is number || data.totalItems is int)) &&
             (!('subtotal' in data) || data.subtotal is number) &&
             (!('discount' in data) || data.discount is number) &&
             (!('tax' in data) || data.tax is number) &&
             data.total is number &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('amountPaid' in data) || data.amountPaid is number) &&
             (!('change' in data) || data.change is number) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 200)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('customerRtn' in data) || (data.customerRtn is string && data.customerRtn.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.status in ['completed', 'cancelled'] &&
             (!('cashier' in data) || (data.cashier is string && data.cashier.size() <= 100));
    }

    function isValidPurchase(data) {
      return data.keys().hasAll(['invoiceNumber', 'supplierId', 'supplierName', 'date', 'timestamp', 'items', 'total', 'status']) &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 100 &&
             data.supplierId is string && data.supplierId.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.timestamp is number &&
             (!('paymentCondition' in data) || (data.paymentCondition is string && data.paymentCondition.size() <= 50)) &&
             (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50)) &&
             data.items is list &&
             (!('totalItems' in data) || (data.totalItems is number || data.totalItems is int)) &&
             (!('subtotal' in data) || data.subtotal is number) &&
             (!('tax' in data) || data.tax is number) &&
             (!('discount' in data) || data.discount is number) &&
             data.total is number &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.status in ['completed', 'cancelled'] &&
             (!('receivedBy' in data) || (data.receivedBy is string && data.receivedBy.size() <= 100));
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['name', 'username', 'password', 'role', 'isActive']) &&
             data.name is string &&
             data.username is string &&
             data.password is string &&
             data.role is string &&
             data.isActive is bool;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['timestamp', 'date', 'userName', 'action', 'module']) &&
             data.timestamp is number &&
             data.date is string &&
             data.userName is string &&
             data.action is string &&
             data.module is string;
    }

    match /inventory/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if isValidId(supplierId) && isValidSupplier(incoming());
      allow delete: if isValidId(supplierId);
    }

    match /audit_history/{auditId} {
      allow read: if true;
      allow create: if isValidId(auditId) && isValidAuditHistory(incoming());
      allow update: if false;
      allow delete: if isValidId(auditId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidStoreSettings(incoming());
      allow delete: if isValidId(settingId);
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create, update: if isValidId(saleId) && isValidSale(incoming());
      allow delete: if isValidId(saleId);
    }

    match /purchases/{purchaseId} {
      allow read: if true;
      allow create, update: if isValidId(purchaseId) && isValidPurchase(incoming());
      allow delete: if isValidId(purchaseId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserAccount(incoming());
      allow delete: if isValidId(userId);
    }

    match /activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidActivityLog(incoming());
      allow delete: if isValidId(logId);
    }

    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
